(text "CHARGE-WD-01 v0.1 - missing heartbeat must clear the external permit latch" (at 12.7 12.7 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "b2850846-fb04-5230-9e73-9cdbc9b96fc3"))
(text "WDO and ENOUT are open drain and tied together per TI. No local FAULT pull-up.\nEN/SET1 tied HIGH: MCU cannot disable this watchdog. EP is assigned logical pad 9." (at 12.7 22.86 0) (effects (font (size 1 1)) (justify left top)) (uuid "f0368847-8d2d-5d80-85ae-80ffb7fb204d"))
(text "Timer: 170..230ms; fault pulse: 170..230ms.\nFault release MUST NOT automatically rearm charge.\nStartup/brownout, GPIO levels, real CD/current\nand persistent INA300 fault remain unverified." (at 12.7 180.34 0) (effects (font (size 1 1)) (justify left top)) (uuid "a2cac18c-ce9f-56a8-a0ae-59d96de1a601"))
