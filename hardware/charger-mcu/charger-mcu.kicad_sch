(text "CHARGE-MCU-01 v0.2 / CHARGE-IO-01 v0.1 - interface proposal; no MCU firmware or PCB" (at 12.7 12.7 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "d1358f96-0846-55c2-9365-395ca03a1f9c"))
(text "ARM_N / WD_HEARTBEAT_N / SOURCE_REQUEST_N: open drain. Release = output LOW.\nFAULT_BUS_N: open drain + input readback; never drive HIGH. No INA300 clear/disable GPIO." (at 12.7 22.86 0) (effects (font (size 1 1)) (justify left top)) (uuid "a5aa30d4-4fdc-5127-bf3a-a860aadb4d92"))
(text "AUX 3.0..3.6V. Settled logic only: startup, brownout, GPIO mode/edges, load and charge current unverified.\nJ604 is NOT direct SOURCE_ALLOW. J607/J608 are logical interfaces, not measured connector pinouts." (at 12.7 264.16 0) (effects (font (size 1 1)) (justify left top)) (uuid "d58418aa-d482-5ce5-89fc-c33dbed85992"))
